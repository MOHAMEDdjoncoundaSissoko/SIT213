#!/bin/bash

# -----------------------------------------------------------
# Script de test pour le Simulateur - Etapes 1 a 5
# -----------------------------------------------------------

# Couleurs pour l'affichage
VERT='\033[0;32m'
ROUGE='\033[0;31m'
NEUTRE='\033[0m'

# Compteurs
NB_TESTS=0
NB_OK=0
NB_KO=0

# Fonction pour les tests normaux (doit reussir et afficher TEB)
# $1 = Description, $2 = Commande
run_test() {
    NB_TESTS=$((NB_TESTS + 1))
    local description="$1"
    local commande="$2"

    echo -n "Test $NB_TESTS : $description ... "

    output=$(eval "$commande" 2>/dev/null)
    exit_code=$?

    if [ $exit_code -eq 0 ] && [[ "$output" == *"TEB"* ]]; then
        echo -e "${VERT}OK${NEUTRE}"
        NB_OK=$((NB_OK + 1))
    else
        echo -e "${ROUGE}KO (exit=$exit_code, sortie: $output)${NEUTRE}"
        NB_KO=$((NB_KO + 1))
    fi
}

# Fonction pour les tests sans bruit qui doivent obtenir un TEB nul
# $1 = Description, $2 = Commande
run_zero_teb_test() {
    NB_TESTS=$((NB_TESTS + 1))
    local description="$1"
    local commande="$2"

    echo -n "Test $NB_TESTS : $description ... "

    output=$(eval "$commande" 2>/dev/null)
    exit_code=$?

    if [ $exit_code -eq 0 ] && [[ "$output" == *"TEB : 0.0"* ]]; then
        echo -e "${VERT}OK${NEUTRE}"
        NB_OK=$((NB_OK + 1))
    else
        echo -e "${ROUGE}KO (exit=$exit_code, sortie: $output)${NEUTRE}"
        NB_KO=$((NB_KO + 1))
    fi
}

# Fonction pour les tests d'erreur (doit echouer avec code non-zero)
# $1 = Description, $2 = Commande
run_error_test() {
    NB_TESTS=$((NB_TESTS + 1))
    local description="$1"
    local commande="$2"

    echo -n "Test $NB_TESTS : $description ... "

    output=$(eval "$commande" 2>/dev/null)
    exit_code=$?

    if [ $exit_code -ne 0 ]; then
        echo -e "${VERT}OK${NEUTRE}"
        NB_OK=$((NB_OK + 1))
    else
        echo -e "${ROUGE}KO (devait echouer mais exit=0)${NEUTRE}"
        NB_KO=$((NB_KO + 1))
    fi
}

echo "------------------------------------------"
echo "  LANCEMENT DES TESTS (Étapes 1 à 5)"
echo "------------------------------------------"

# --- ÉTAPE 1 : transmission logique ---

# Test 1 : message aléatoire par défaut
run_test "Aléatoire (défaut)" "./simulateur"

# Test 2 : message fixe
run_test "Message fixe" "./simulateur -mess 1010101"

# Test 3 : semence
run_test "Seed (reproductibilité)" "./simulateur -mess 50 -seed 42"

# --- ÉTAPE 2 : transmission analogique non bruitée ---

# Test 4 : -form active le mode analogique
run_test "Analogique (-form RZ)" "./simulateur -mess 1100 -form RZ"

# Test 5 : forme NRZ
run_test "Analogique (-form NRZ)" "./simulateur -mess 1100 -form NRZ"

# Test 6 : -nbEch active le mode analogique
run_test "Analogique (-nbEch 50)" "./simulateur -mess 1100 -nbEch 50"

# Test 7 : -ampl active le mode analogique
run_test "Analogique (-ampl)" "./simulateur -mess 1100 -ampl -2.0 2.0"

# Test 8 : chaîne analogique complète (toutes les options)
run_test "Analogique complet" "./simulateur -mess 101 -form NRZ -nbEch 30 -ampl 0 5"

# --- ÉTAPE 3 : canal bruité gaussien (-snrpb) ---

# Test 9 : Eb/N0 élevé
run_test "Bruit (Eb/N0 élevé, peu d'erreurs)" "./simulateur -mess 1000 -form NRZ -nbEch 30 -snrpb 20"

# Test 10 : Eb/N0 faible
run_test "Bruit (Eb/N0 faible, beaucoup d'erreurs)" "./simulateur -mess 1000 -form NRZ -nbEch 30 -snrpb -5"

# Test 11 : bruit avec NRZT et amplitudes
run_test "Bruit complet (NRZT + ampl + snrpb)" "./simulateur -mess 100 -form NRZT -nbEch 30 -ampl -1 1 -snrpb 5"

# Test 12 : -snrpb seul active le mode analogique
run_test "Bruit seul (-snrpb active le mode analogique)" "./simulateur -mess 100 -snrpb 10 -seed 1"

# Test 13 : message long (performance) - doit se terminer rapidement (10s max), sans sonde graphique
# timeout (GNU coreutils) n'existe pas sur macOS par défaut ; on utilise gtimeout
# si disponible (brew install coreutils), sinon on lance sans limite de temps.
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD="timeout 10"
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD="gtimeout 10"
else
    TIMEOUT_CMD=""
fi
run_test "Performance (message aléatoire de 10000 bits)" "$TIMEOUT_CMD ./simulateur -mess 10000 -form NRZT -nbEch 30"

# --- ÉTAPE 4 : canal à trajets multiples (-ti dt ar ...) ---

# Test 14 : un trajet indirect seul (étape 4a)
run_test "Trajets indirects (1 trajet, sans bruit)" "./simulateur -mess 1000 -form NRZ -nbEch 30 -ti 10 0.5"

# Test 15 : un trajet indirect et bruit gaussien (étape 4b)
run_test "Trajets indirects (1 trajet, bruité)" "./simulateur -mess 1000 -form NRZ -nbEch 30 -snrpb 10 -ti 10 0.5"

# Test 16 : trois trajets indirects et bruit gaussien (étape 4b)
run_test "Trajets indirects (3 trajets, bruité)" "./simulateur -mess 1000 -form NRZ -nbEch 30 -snrpb 10 -ti 10 0.5 20 0.3 30 0.1"

# --- ÉTAPE 5 : codage de canal (-codeur) ---

# Test 17 : codeur avec signal NRZ sans bruit
run_zero_teb_test "Codeur canal (NRZ, sans bruit)" "./simulateur -codeur -mess 1011001 -form NRZ -nbEch 30 -ampl -1 1"

# Test 18 : codeur avec signal RZ sans bruit
run_zero_teb_test "Codeur canal (RZ, sans bruit)" "./simulateur -codeur -mess 1011001 -form RZ -nbEch 30 -ampl -1 1"

# Test 19 : codeur avec signal NRZT sans bruit
run_zero_teb_test "Codeur canal (NRZT, sans bruit)" "./simulateur -codeur -mess 1011001 -form NRZT -nbEch 30 -ampl -1 1"

# --- TESTS D'ERREURS (le simulateur doit échouer) ---

# Test 20 : option inconnue
run_error_test "Erreur (option inconnue)" "./simulateur -foobar"

# Test 21 : amplitude non numérique
run_error_test "Erreur (amplitude invalide)" "./simulateur -ampl abc"

# Test 22 : nombre d'échantillons négatif
run_error_test "Erreur (nbEch invalide)" "./simulateur -nbEch -5"

# Test 23 : nombre d'échantillons sous le minimum
run_error_test "Erreur (nbEch 3, en dessous du minimum de 10)" "./simulateur -nbEch 3"

# Test 24 : amplitude min > max
run_error_test "Erreur (ampl min > max)" "./simulateur -ampl 1 0"

# Test 25 : amplitude min = max
run_error_test "Erreur (ampl min = max)" "./simulateur -ampl 1 1"

# Test 26 : Eb/N0 non numérique
run_error_test "Erreur (snrpb non flottant)" "./simulateur -snrpb abc"

# Test 27 : Eb/N0 manquant
run_error_test "Erreur (snrpb sans valeur)" "./simulateur -snrpb"

# Test 28 : -ti sans couple dt ar
run_error_test "Erreur (ti sans couple)" "./simulateur -ti"

# Test 29 : -ti avec dt mais sans ar
run_error_test "Erreur (ti sans valeur ar)" "./simulateur -ti 10"

# Test 30 : -ti avec plus de 5 couples
run_error_test "Erreur (ti plus de 5 couples)" "./simulateur -ti 1 0.1 2 0.1 3 0.1 4 0.1 5 0.1 6 0.1"

echo "------------------------------------------"
echo -e "  RÉSULTAT : ${VERT}${NB_OK}/${NB_TESTS}${NEUTRE} OK"
if [ $NB_KO -gt 0 ]; then
    echo -e "           ${ROUGE}${NB_KO}/${NB_TESTS}${NEUTRE} KO"
fi
echo "------------------------------------------"

# Code de sortie du script (0 si tout est OK, 1 sinon)
if [ $NB_KO -gt 0 ]; then
    exit 1
else
    exit 0
fi
